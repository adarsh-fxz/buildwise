{
  "name": "buildwise",
  "displayName": "BuildWise",
  "description": "A mentor that teaches you to build features in your own codebase, instead of building them for you.",
  "version": "0.0.1",
  "private": true,
  "publisher": "buildwise",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/adarsh-fxz/buildwise.git"
  },
  "engines": {
    "vscode": "^1.95.0",
    "node": ">=22"
  },
  "categories": [
    "Education",
    "Programming Languages"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "BuildWise does not run your type checker or tests in untrusted workspaces.",
      "restrictedConfigurations": [
        "buildwise.checks.typecheckCommand",
        "buildwise.checks.testCommand"
      ]
    }
  },
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "buildwise",
          "title": "BuildWise",
          "icon": "media/buildwise.svg"
        }
      ]
    },
    "views": {
      "buildwise": [
        {
          "type": "webview",
          "id": "buildwise.mentor",
          "name": "Mentor"
        }
      ]
    },
    "commands": [
      {
        "command": "buildwise.showSharedContext",
        "title": "Show Shared Context",
        "category": "BuildWise"
      },
      {
        "command": "buildwise.setupProvider",
        "title": "Set Up Model Provider",
        "category": "BuildWise"
      },
      {
        "command": "buildwise.removeApiKeys",
        "title": "Remove Saved API Keys",
        "category": "BuildWise"
      },
      {
        "command": "buildwise.resetCheckPermissions",
        "title": "Ask Again Before Running Checks",
        "category": "BuildWise"
      }
    ],
    "configuration": {
      "title": "BuildWise",
      "properties": {
        "buildwise.provider": {
          "type": "string",
          "enum": [
            "gemini",
            "groq",
            "openrouter",
            "ollama",
            "anthropic",
            "custom"
          ],
          "enumDescriptions": [
            "Google Gemini (free tier)",
            "Groq (free tier)",
            "OpenRouter (free models)",
            "Ollama on your computer (free)",
            "Anthropic Claude (paid)",
            "Another OpenAI-compatible API"
          ],
          "default": "gemini",
          "markdownDescription": "Where BuildWise sends requests. Run **BuildWise: Set Up Model Provider** to choose a provider, key and model together.",
          "scope": "application"
        },
        "buildwise.model": {
          "type": "string",
          "default": "",
          "markdownDescription": "The model name, exactly as the provider lists it. Set by **BuildWise: Set Up Model Provider**.",
          "scope": "application"
        },
        "buildwise.baseUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "The API endpoint for Ollama or another OpenAI-compatible provider. Leave empty for the provider's default.",
          "scope": "application"
        },
        "buildwise.context.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Extra files BuildWise must never share, as `.gitignore`-style patterns. Secrets, dependencies, build output and anything in `.gitignore` are already excluded.",
          "scope": "resource"
        },
        "buildwise.checks.typecheckCommand": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "markdownDescription": "Command that type-checks the project when you check your work. Leave unset to use `tsc --noEmit` in projects with a `tsconfig.json`. Set to an empty string to skip the type check.",
          "scope": "resource"
        },
        "buildwise.checks.testCommand": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "markdownDescription": "Command that runs the tests when you check your work. It must run once and exit, not watch. Leave unset to use the `test` script in `package.json`. Set to an empty string to skip tests.",
          "scope": "resource"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs --production",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm test",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/vscode": "~1.95.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "ignore": "^7.0.14",
    "openai": "^7.43.0",
    "zod": "^4.6.7"
  }
}

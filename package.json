{
  "name": "buildwise",
  "displayName": "BuildWise",
  "description": "A mentor that teaches you to build features in your own codebase, instead of building them for you.",
  "version": "0.0.1",
  "private": true,
  "publisher": "buildwise",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/adarsh-fxz/buildwise.git"
  },
  "engines": {
    "vscode": "^1.95.0",
    "node": ">=22"
  },
  "categories": [
    "Education",
    "Programming Languages"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "buildwise.showSharedContext",
        "title": "Show Shared Context",
        "category": "BuildWise"
      }
    ],
    "configuration": {
      "title": "BuildWise",
      "properties": {
        "buildwise.context.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Extra files BuildWise must never share, as `.gitignore`-style patterns. Secrets, dependencies, build output and anything in `.gitignore` are already excluded.",
          "scope": "resource"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs --production",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm test",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/vscode": "~1.95.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "ignore": "^7.0.14"
  }
}
